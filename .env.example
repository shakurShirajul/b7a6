# Never commit a populated .env file. Render supplies PORT, DATABASE_URL, and
# REDIS_URL from managed services; enter provider credentials as secret values.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_donation
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Public browser-facing origin used for Stripe Checkout return URLs. HTTPS in production.
APP_URL=http://localhost:5000
# Comma-separated exact browser origins; no paths, wildcards, or trailing slashes.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
# Number of trusted reverse-proxy hops. Use 1 on Render and 0 for direct local traffic.
TRUST_PROXY_HOPS=0
BCRYPT_SALT_ROUNDS=
# Seed-only secret. Production/demo seeding refuses to run without it.
DEMO_PASSWORD=
JWT_REFRESH_TOKEN_SECRET=
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_EXPIRATION=
JWT_ACCESS_TOKEN_EXPIRATION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://<api-host>/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=
REDIS_URL=redis://localhost:6379
# Response deadline for nonblocking Redis commands/producer publication (100..10000 ms).
REDIS_COMMAND_TIMEOUT_MS=1500
# Maximum duration for each PostgreSQL/Redis readiness probe (milliseconds).
READINESS_TIMEOUT_MS=1500
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
DONOR_MIN_AGE_YEARS=18
DONOR_MAX_AGE_YEARS=65
DONOR_MIN_WEIGHT_KG=50
DONOR_MIN_DONATION_INTERVAL_DAYS=120
MATCHING_DEFAULT_RADIUS_KM=25
MATCHING_MAX_RADIUS_KM=50
# The candidate cap applies after live eligibility. Scans use pages of at most 200.
MATCHING_MAX_CANDIDATES=500
MATCHING_MAX_INVITATIONS=50
DONOR_INVITATION_TTL_MINUTES=60
EXPIRATION_BATCH_SIZE=100
# Use Stripe test-mode secrets until a separately approved live-mode launch.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signs POST https://<api-host>/api/v1/payments/webhook in production.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=BDT
PAYMENT_MIN_MINOR_UNITS=100
PAYMENT_MAX_MINOR_UNITS=99999999
