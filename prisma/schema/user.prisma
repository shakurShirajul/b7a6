model User {
  id          Int        @id @default(autoincrement())
  name        String
  email       String     @unique @db.VarChar(320)
  phone       String
  avatar      String?
  password    String
  role        Role
  status      UserStatus @default(ACTIVE)
  dateOfBirth DateTime?
  gender      Gender?

  lastLoginAt            DateTime?
  emailVerifiedAt        DateTime?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  deletedAt              DateTime?

  oauthAccounts         OAuthAccount[]
  refreshSessions       RefreshSession[]
  notifications         Notification[]
  patientProfile        PatientProfile?
  donorProfile          DonorProfile?
  donorProfilesVerified DonorProfile[]          @relation("DonorProfileVerifiedBy")
  eligibilityChecks     EligibilityAssessment[] @relation("EligibilityCheckedBy")
  hospitalsVerified     Hospital[]              @relation("HospitalVerifiedBy")
  bloodRequestsVerified BloodRequest[]          @relation("BloodRequestVerifiedBy")
  requestVerifications  RequestVerification[]   @relation("RequestVerifiedBy")
  donationsConfirmed    Donation[]              @relation("DonationConfirmedBy")
  payments              Payment[]
  auditLogs             AuditLog[]              @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([deletedAt])
}
